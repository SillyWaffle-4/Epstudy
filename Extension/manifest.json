{
  "manifest_version": 3,
  "name": "EPStudy Sync",
  "description": "Syncs signed-in Canvas, TeamSnap, and Membean tasks into EPStudy without a popup.",
  "version": "1.2.1",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["alarms", "declarativeNetRequest", "notifications", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://eastsideprep.instructure.com/*",
    "https://*.instructure.com/*",
    "https://*.teamsnap.com/*",
    "https://teamsnap.com/*",
    "https://*.membean.com/*",
    "https://membean.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*",
        "https://*.github.io/*",
        "https://*.netlify.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["website-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://eastsideprep.instructure.com/*",
        "https://*.instructure.com/*",
        "https://*.teamsnap.com/*",
        "https://teamsnap.com/*",
        "https://*.membean.com/*",
        "https://membean.com/*"
      ],
      "js": ["source-scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
