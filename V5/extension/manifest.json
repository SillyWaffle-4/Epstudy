{
  "manifest_version": 3,
  "name": "EPStudy Sync",
  "description": "Syncs EPStudy V5 with Canvas, TeamSnap schedules, Membean, and the selected website version.",
  "version": "1.2.1",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["alarms", "declarativeNetRequest", "notifications", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://eastsideprep.instructure.com/*",
    "https://go.teamsnap.com/*",
    "https://*.membean.com/*",
    "https://membean.com/*",
    "https://www.eastsideprep.org/*",
    "https://sillywaffle-4.github.io/Epstudy/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sillywaffle-4.github.io/Epstudy/*"
      ],
      "js": ["website-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://eastsideprep.instructure.com/*",
        "https://go.teamsnap.com/*",
        "https://*.membean.com/*",
        "https://membean.com/*"
      ],
      "js": ["source-scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
